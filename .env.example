# Names only, no values (CLAUDE.md §5). Copy to .env, which git ignores, and fill in locally.

# Required
DATABASE_URL=
OWNER_PASSWORD_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Optional: debug, info, warn or error (default info)
LOG_LEVEL=

# Optional channel groups: set every name in a group, or none of them
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=

DISCORD_WEBHOOK_URL=

GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER=
ALERT_EMAIL_TO=
